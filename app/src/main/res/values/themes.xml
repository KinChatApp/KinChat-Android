<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tuktak" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FAFAFE</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 🚀 NEW: Splash Screen Theme (Light) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FAFAFE</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Tuktak</item>
    </style>
</resources>
